{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "labels": ["renovate"],
  "gradle": {
    "enabled": true
  },
  "packageRules": [
    {
      "groupName": "Seitenbau gradle Plugin",
      "matchPackageNames": ["de.seitenbau.serviceportal.prozesspipeline"],
      "matchUpdateTypes": ["major", "minor", "patch"],
      "automerge": true,
      "enabled": true
    },
    {
      "matchDepTypes": ["dependencies", "devDependencies"],
      "enabled": false
    }
  ]
}
